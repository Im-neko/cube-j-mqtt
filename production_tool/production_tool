#!/system/bin/sh
# Cube J のセットアップ(USB メモリから 1 回で行う)。
#
# USB メモリの直下に CubeJMTS.txt と production_tool/ があると、Cube の gndctrl が /usr/sbin/launch_pt_init.sh を
# 実行する。launch_pt_init.sh は /mnt/usb/production_tool/ を /tmp/production_tool/ にコピーし、実行の権限を付けて、
# このファイル(production_tool/production_tool)を root で実行する。
#
# すること(Wi-Fi の設定には触れない):
#   1. /system に有線 LAN の起動(ethup.sh・ethup.rc)・ブリッジの起動(cubej_bridge.sh・mqtt_ha_bridge.rc)・
#      ブリッジ本体の控え(/system/etc/cubej/mqtt_bridge.py)を置く。
#      /system の置き換える既存のファイルは、初回だけ /data/local/cubej-backup/ に退避する
#   2. config.json・mqtt_bridge.py を /data/local/ に置く(退避せずに上書きする。config.json は権限 600)
#   3. 結果を USB メモリの setup-cubej.txt(と /data/local/cubej-setup.txt)に書き、LED を白で 10 回点滅させる
# 終わったら USB メモリを抜き、有線 LAN アダプター(ハブ無し)を挿して電源を入れ直す。rc は起動時に読まれる。
PT=/tmp/production_tool
USB=/mnt/usb
OUT=/data/local/cubej-setup.txt
BK=/data/local/cubej-backup
L=/sys/class/leds
led() { echo $1 > $L/red/brightness; echo $2 > $L/green/brightness; echo $3 > $L/blue/brightness; }
led 255 180 0   # 開始: 黄

install_file() {  # 元 先 権限
  if [ -f "$2" ] && [ ! -f "$BK$2" ]; then
    mkdir -p "$(dirname "$BK$2")" && cp -p "$2" "$BK$2" && echo "backup $2"
  fi
  cp "$1" "$2" && chmod $3 "$2" && echo "installed $2"
}

{
  echo "== setup start: $(date)"
  getprop ro.nextdrive.model
  getprop ro.build.version.release
  mount -o rw,remount /
  mkdir -p /system/etc/cubej
  install_file $PT/ethup.sh          /system/bin/ethup.sh                755
  install_file $PT/ethup.rc          /system/etc/init/ethup.rc           644
  install_file $PT/cubej_bridge.sh   /system/bin/cubej_bridge.sh         755
  install_file $PT/mqtt_ha_bridge.rc /system/etc/init/mqtt_ha_bridge.rc  644
  install_file $PT/mqtt_bridge.py    /system/etc/cubej/mqtt_bridge.py    644
  sync
  mount -o ro,remount /
  cp $PT/mqtt_bridge.py /data/local/mqtt_bridge.py && chmod 755 /data/local/mqtt_bridge.py && echo "installed /data/local/mqtt_bridge.py"
  if [ -f $PT/config.json ]; then
    cp $PT/config.json /data/local/config.json && chmod 600 /data/local/config.json && echo "installed /data/local/config.json"
    grep -qE '"<|192\.0\.2\.' /data/local/config.json && echo "注意: config.json に雛形の値(<...> か 192.0.2.x)が残っている。ブリッジは B ルート・MQTT につながらない"
  else
    echo "注意: production_tool/config.json が無い(ブリッジは起動しても動かない。config.example.json をコピーして書き、もう一度実行する)"
  fi
  md5sum /system/bin/ethup.sh /system/etc/init/ethup.rc /system/bin/cubej_bridge.sh \
         /system/etc/init/mqtt_ha_bridge.rc /system/etc/cubej/mqtt_bridge.py /data/local/mqtt_bridge.py
  echo "== setup end: $(date)"
} > $OUT 2>&1

cp $OUT $USB/setup-cubej.txt && sync

# 完了: 白で 10 回点滅
i=0
while [ $i -lt 10 ]; do
  led 255 255 255; sleep 1; led 0 0 0; sleep 1
  i=$((i+1))
done
