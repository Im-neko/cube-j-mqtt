#!/system/bin/sh
# 汎用のランナー。production_tool/cmd.sh を root で実行し、出力を USB メモリの run-cubej.txt と
# /data/local/run.txt に書く。cmd.sh を差し替えるだけで、任意の調査・実験ができる。
# 目印: 開始=黄の点灯、完了=マゼンタの点滅 5 回(cmd.sh が止まると黄のまま)。
PT="/tmp/production_tool"
OUT=/data/local/run.txt
L=/sys/class/leds
echo 255 > $L/red/brightness; echo 180 > $L/green/brightness; echo 0 > $L/blue/brightness

{
  echo "== run start: $(date)"
  sh $PT/cmd.sh 2>&1
  echo "== run end (rc=$?): $(date)"
} > $OUT 2>&1

for m in $(grep -E " vfat | exfat | fuse " /proc/mounts | cut -d' ' -f2); do
  cp $OUT "$m/run-cubej.txt" 2>/dev/null && sync
done

i=0
while [ $i -lt 5 ]; do
  echo 255 > $L/red/brightness; echo 0 > $L/green/brightness; echo 255 > $L/blue/brightness
  sleep 1
  echo 0 > $L/red/brightness; echo 0 > $L/green/brightness; echo 0 > $L/blue/brightness
  sleep 1
  i=$((i+1))
done
